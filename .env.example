# ==============================================================================
# HARRY & CO JEANS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Runtime
NODE_ENV=production
PORT=3000

# ------------------------------------------------------------------------------
# 1. ORIGIN SERVER PROTECTION & EDGE PROXY VERIFICATION
# ------------------------------------------------------------------------------
# Set to 'true' in production to reject direct origin IP connections
REQUIRE_EDGE_PROXY=true

# Azure Front Door Unique Identifier (from Front Door profile)
# All inbound requests must present this header: X-Azure-FDID: <ID>
AZURE_FRONT_DOOR_ID=your-azure-front-door-guid-here

# Secret shared between Edge Reverse Proxy and Node.js backend
# Header: X-Origin-Verify: <SECRET>
ORIGIN_VERIFY_SECRET=your-cryptographically-secure-random-secret-here

# ------------------------------------------------------------------------------
# 2. CORS & DOMAIN ISOLATION
# ------------------------------------------------------------------------------
# Comma-separated list of permitted frontend origins (Never use '*' in production)
CORS_ALLOWED_ORIGINS=https://harryandcojeans.com,https://www.harryandcojeans.com,https://admin.harryandcojeans.com

# ------------------------------------------------------------------------------
# 3. ADMINISTRATIVE NETWORK ACCESS
# ------------------------------------------------------------------------------
# Restrict admin access to trusted office or VPN IPs (Optional - comma separated)
# ADMIN_ALLOWED_IPS=203.0.113.50,198.51.100.22

# ------------------------------------------------------------------------------
# 4. DATABASE CONFIGURATION (AZURE POSTGRESQL FLEXIBLE SERVER)
# ------------------------------------------------------------------------------
# Must use Private DNS / Private Endpoint Hostname (No Public IP)
PGHOST=harryandco-db.private.postgres.database.azure.com
PGPORT=5432
PGDATABASE=harryandco_production
PGUSER=harryandco_app
PGPASSWORD=your-super-strong-database-password-here
PG_POOL_MAX=20
PG_POOL_MIN=4

# ------------------------------------------------------------------------------
# 5. AUTHENTICATION & SECRETS (STORED IN AZURE KEY VAULT)
# ------------------------------------------------------------------------------
JWT_SECRET=your-high-entropy-jwt-signing-key-here
