# Dependencies
node_modules/

# Env & secrets
.env
.env.local

# Database (created on first run / seed)
server/data/*.db
server/data/*.db-journal
server/data/*.db-wal
server/data/*.db-shm

# Uploads (user/admin-uploaded media)
public/uploads/*
!public/uploads/.gitkeep

# Logs & OS cruft
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Local editor/tooling state (machine-specific)
.claude/settings.local.json
